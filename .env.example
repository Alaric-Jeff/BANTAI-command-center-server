# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
APP_NAME=BANTAI
APP_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3001

# ==========================================
# SEEDER CONFIGURATION
# ==========================================
SUPERADMIN_EMAIL=admin@bantai.ph
SUPERADMIN_PASSWORD=your_superadmin_password_change_me

# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ==========================================
# POSTGRESQL / POSTGIS DATABASE
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_local_db_password
DB_DATABASE=bantai_dev

# Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=2000

# Optional: Connection string format
DATABASE_URL=postgresql://postgres:your_local_db_password@localhost:5432/bantai_dev?sslmode=disable

# ==========================================
# REDIS (Heartbeats, Pub/Sub, Dead-Man Switch)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=your_cookie_signing_secret_change_me

# ==========================================
# SYSTEM & GEOFENCING CONFIG
# ==========================================
# Default radius (meters) for PostGIS spatial alerts
DEFAULT_ALERT_RADIUS_METERS=5000
# Redis TTL (seconds) for device heartbeats before triggering dead-man switch
HEARTBEAT_TIMEOUT_SECONDS=3